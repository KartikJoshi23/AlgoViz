# ═══════════════════════════════════════════════════════════════════
# AlgoViz — .gitignore
# ═══════════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
*.egg
dist/
build/

# ── Virtual Environment ──────────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Node / Frontend ──────────────────────────────────────────────
node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/next-env.d.ts
*.tsbuildinfo
.npm
.pnpm-store/

# ── IDE / Editor ─────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.sublime-*
.project
.settings/

# ── Environment / Secrets ────────────────────────────────────────
.env
.env.*
!.env.example

# ── Databases ────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── Runtime state (regenerated) ──────────────────────────────────
backend/data/
backend/ml_models/
backend/data/recordings/

# ── OS Files ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.lnk

# ── Logs ─────────────────────────────────────────────────────────
*.log
logs/

# ── Docker (local volumes) ───────────────────────────────────────
docker-compose.override.yml

# ── Legacy / Deprecated ──────────────────────────────────────────
.streamlit/

# ── Tooling caches ────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
frontend/lighthouse/
