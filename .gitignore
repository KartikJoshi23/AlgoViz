# ═══════════════════════════════════════════════════════════════════
# AlgoViz — .gitignore
# ═══════════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
*.egg
dist/
build/

# ── Virtual Environment ──────────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Node / Frontend ──────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
.npm
.pnpm-store/

# ── IDE / Editor ─────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.sublime-*
.project
.settings/

# ── Environment / Secrets ────────────────────────────────────────
.env
.env.*
!.env.example

# ── Databases ────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── ML Models (regenerated at runtime) ───────────────────────────
backend/ml_models/*.joblib
backend/ml_models/*.pkl

# ── OS Files ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.lnk

# ── Logs ─────────────────────────────────────────────────────────
*.log
logs/

# ── Docker (local volumes) ───────────────────────────────────────
docker-compose.override.yml

# ── Legacy / Deprecated ──────────────────────────────────────────
.streamlit/
