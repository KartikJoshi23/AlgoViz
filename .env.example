# AlgoViz — environment template.  cp .env.example backend/.env
# All values have sensible defaults. Production requires SECRET_KEY and ADMIN_TOKEN.

# ── App ──────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false
SECRET_KEY=algoviz-dev-secret-change-in-production   # production refuses this default

# ── Access ───────────────────────────────────────────────────────
# Reads are public. Changes (strategies, alert rules, backtests) need a bearer credential
# when MUTATIONS_REQUIRE_AUTH is on — by default in production only.
# ADMIN_TOKEN=<at least 32 random characters>   # e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
# MUTATIONS_REQUIRE_AUTH=true
# ALLOW_REGISTRATION=false                      # default: off in production
# CORS_ORIGINS=["https://your-frontend.example"]
# CORS_ORIGIN_REGEX=https://algoviz-[a-z0-9-]+\.vercel\.app   # opt-in, for preview deployments
# TRUSTED_PROXIES=["127.0.0.1"]                 # whose X-Forwarded-For is believed (addresses or CIDRs)
RATE_LIMIT_RPM=240                              # per client, every request
RATE_LIMIT_WRITE_RPM=60                         # per client, POST / PATCH / DELETE
RATE_LIMIT_BACKTEST_RPM=6                       # per client, backtest submissions
WS_MAX_CLIENTS=200

# ── Market data ──────────────────────────────────────────────────
DATA_SOURCE=live                 # live      = Binance (host fallbacks on HTTP 451)
                                 # replay    = recorded NDJSON(.gz) through the same pipeline
                                 # synthetic = built-in LOB simulator (no internet needed)
SYMBOLS=["BTCUSDT"]              # any of the allowlist: BTCUSDT, ETHUSDT, SOLUSDT
# REPLAY_FILE=tests/fixtures/btcusdt-20s.ndjson.gz   # required for DATA_SOURCE=replay
# REPLAY_SPEED=1.0                                   # 0 = as fast as possible
# Record your own:  python scripts/record_stream.py --seconds 120 --out data/recordings/btc.ndjson.gz

# ── Persistence ──────────────────────────────────────────────────
# Defaults: data/algoviz.db for live; data/algoviz-<source>.db and ml_models/<source>/
# for synthetic / replay, so simulator bars and models never touch the live ones.
# DATABASE_URL=sqlite+aiosqlite:///./data/algoviz.db
# DATABASE_URL=sqlite+aiosqlite:////var/data/algoviz.db              # hosted: SQLite on a persistent disk (render.yaml)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/algoviz   # or Postgres
# ML_MODEL_DIR=/var/data/ml_models                                     # trained models; keep on a persistent disk
SNAPSHOT_RETENTION_DAYS=7
PREDICTION_RETENTION_DAYS=7
ALERT_HISTORY_RETENTION_DAYS=30
BAR_RESUME_MAX_GAP_S=60          # after a longer outage the charts start fresh instead of splicing history

# ── Intelligence ─────────────────────────────────────────────────
ML_HORIZON_S=5                   # label / prediction horizon in seconds (bars are 1 s)
ML_MIN_DATA_POINTS=300           # labelled samples before the first training run
ML_SIGNAL_THRESHOLD=0.45         # min calibrated probability for a long/short signal
ML_TRAIN_THREADS=0               # training / HMM fits run in a spawned process; 0 = half the cores
                                 # (set it on a container: the core count seen is the host's, not the quota)
ML_TRAIN_TIMEOUT_S=900
BACKTEST_MIN_BARS=600            # below this the backtester uses synthetic history
BACKTEST_MAX_CONCURRENT=2        # more are queued; beyond BACKTEST_MAX_QUEUED (8) the API answers 429

# ── Health ───────────────────────────────────────────────────────
FEED_STALE_S=10                  # no market event for this long ⇒ feed "stale", /health/ready → 503
LOOP_LAG_DEGRADED_MS=250         # event-loop lag p99 above this ⇒ /health "degraded", /health/ready → 503

# ── Notifications ────────────────────────────────────────────────
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Book payload ─────────────────────────────────────────────────
BOOK_PROFILE_BPS=25              # maximum half-band of the binned depth profile (heatmap, terrain)
BOOK_PROFILE_BINS=64             # bins per side

# ── Frontend (Next.js) — cp frontend/.env.example frontend/.env.local ──
# Inlined at build time: the origin the *browser* uses to reach the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
